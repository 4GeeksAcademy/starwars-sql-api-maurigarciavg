{
  "editor.formatOnSave": true, // ✅ Buena práctica para mantener el código limpio
  "editor.defaultFormatter": "esbenp.prettier-vscode", // ✅ Buen uso de un formateador estándar
  "workbench.editorAssociations": {
    "*.md": "vscode.markdown.preview.editor" // ✅ Buena asociación para archivos markdown
  },
  "python-envs.defaultEnvManager": "ms-python.python:pipenv" // ✅ Buen uso de pipenv para manejar entornos
}
